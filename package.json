{
  "name": "anan-celestial-wallpaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-capable Three.js solar system and Earth orbit wallpaper for Wallpaper Engine",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "satellite.js": "7.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
